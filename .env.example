APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production database is PostgreSQL. SQLite is acceptable for local development and tests.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=atlas_market
DB_USERNAME=atlas
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Outgoing mail. Port 587 with STARTTLS. Port 465 would be MAIL_SCHEME=smtps.
# POP3 and IMAP are for reading a mailbox; this app only sends.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=eg-ss.com
MAIL_PORT=587
MAIL_USERNAME=you@eg-ss.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="you@eg-ss.com"
MAIL_FROM_NAME="${APP_NAME}"

STORE_ADMIN_EMAIL=you@eg-ss.com

# Seeded local admin, printed by the database seeder only. Never show this on the storefront.
# admin@example.test / password

STORE_CURRENCY=EGP
STORE_MONEY_SCALE=4
ANALYTICS_TIMEZONE=Africa/Cairo
ANALYTICS_GEOIP_URL=http://ip-api.com/json/{ip}?fields=status,message,country,countryCode,regionName,city,lat,lon
GA4_MEASUREMENT_ID=
META_PIXEL_ID=
SMS_DRIVER=log
SMS_HTTP_URL=

PAYMOB_ENABLED=false
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_CURRENCY=EGP
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_NOTIFICATION_URL=
PAYMOB_REDIRECTION_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
